{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/**",
      "packages/**",
      "scripts/**",
      "infra/**",
      "assets/source-models/**",
      "Dockerfile",
      "package.json",
      "pnpm-lock.yaml",
      "railway.json"
    ]
  },
  "deploy": { "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 3 }
}
