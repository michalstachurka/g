# Baza danych (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/doorconf

# Redis / kolejki
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
SESSION_SECRET=zmien-mnie-na-losowy-sekret
SIGNED_URL_SECRET=zmien-mnie-na-inny-losowy-sekret
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontendy
CONFIGURATOR_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# Storage: fs | s3
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./var/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Seed (konto administratora tworzone przez skrypt seed)
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=Demo1234!
SEED_PLATFORM_OWNER_EMAIL=owner@platform.local
SEED_PLATFORM_OWNER_PASSWORD=Owner1234!

# Worker / PDF
CHROMIUM_PATH=/opt/pw-browsers/chromium
